{
  "uid": "bank-ab-toggle",
  "title": "Bank · AB Toggle",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "섀도우 매칭률 · 선택 기간",
      "description": "일치 / (일치 + 불일치). 호출 실패·큐 거부 제외. 비교 완료 표본이 없으면 비율을 표시하지 않습니다. 현재 기간에 결과가 없다면 LEGACY 서버의 BALANCE_SHADOW_ENABLED=true와 LEGACY 요청 발생 여부를 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * ((sum(increase(bank_shadow_comparisons_total{result=~\"matched\"}[$__range]))) or vector(0)) / (sum(increase(bank_shadow_comparisons_total{result=~\"matched|mismatched\"}[$__range])) > 0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "표본 없음",
          "decimals": 2,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
